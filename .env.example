# Copy to .env.local. Values in this file are intentionally blank/non-sensitive.

# Optional server-only Copernicus Climate Data Store credential. Used by
# explicit ERA5 retrieval and provider health checks. The default point
# analysis does not automatically apply reanalysis. Never rename this with a
# NEXT_PUBLIC_ prefix: that would expose it to browser JavaScript.
# https://cds.climate.copernicus.eu/how-to-api
CDS_API_KEY=

# MCP/server logging verbosity: error, warn, info, or debug.
LOG_LEVEL=info
