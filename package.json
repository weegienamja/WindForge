{
  "name": "windforge",
  "private": true,
  "description": "Screening-level wind energy site evidence and pre-feasibility toolkit",
  "author": "Jamie Blair <jamie@jamieblair.co.uk>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "benchmark:layouts": "tsx packages/core/benchmarks/candidate-layout-search.ts",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "biome format .",
    "check": "pnpm format:check && turbo run lint check test build && pnpm --filter @jamieblair/windforge-mcp validate-publish",
    "build:cloudflare": "pnpm --filter @jamieblair/windforge-core build && pnpm --filter @jamieblair/windforge build && pnpm --filter @jamieblair/windforge-demo build:cloudflare",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm --filter @jamieblair/windforge-demo deploy:cloudflare",
    "preview:cloudflare": "pnpm build:cloudflare && pnpm --filter @jamieblair/windforge-demo preview:cloudflare"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "next": "^15.5.28",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^5.7.3",
    "vite": "7.3.7"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "2.1.1",
      "baseline-browser-mapping": "2.11.0",
      "body-parser": "2.4.0",
      "browserslist": "4.28.7",
      "dompurify": "3.4.17",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.9",
      "fflate": "0.8.3",
      "glob@10": "10.5.0",
      "hono": "4.13.11",
      "ip-address": "10.7.4",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.26",
      "proxy-addr": "2.0.8",
      "qs": "6.16.1",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici": "7.30.1",
      "vite": "7.3.7"
    }
  }
}
