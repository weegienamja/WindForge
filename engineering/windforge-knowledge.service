[Unit]
Description=WindForge engineering knowledge link
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
User=windforge
WorkingDirectory=/opt/windforge
EnvironmentFile=/etc/windforge.env
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/windforge/venv/bin/python /opt/windforge/service.py
Restart=always
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=360M
CPUQuota=65%
[Install]
WantedBy=multi-user.target
